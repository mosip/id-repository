<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<springProperty scope="context" name="appName" source="spring.application.name"/>
	<springProperty scope="context" name="logPath" source="logging.file.path" defaultValue="logs"/>

	<!-- Human-readable lines on console while developing locally -->
	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{40}) - %msg%n</pattern>
		</encoder>
	</appender>

	<!-- JSON lines in file for grep / log tools (same as before) -->
	<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${logPath}/id-repository.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${logPath}/id-repository.%d{yyyy-MM-dd}.log</fileNamePattern>
			<maxHistory>14</maxHistory>
		</rollingPolicy>
		<encoder class="net.logstash.logback.encoder.LogstashEncoder">
			<customFields>{"appName":"${appName}"}</customFields>
		</encoder>
	</appender>

	<root level="INFO">
		<appender-ref ref="STDOUT"/>
		<appender-ref ref="FILE"/>
	</root>
</configuration>
